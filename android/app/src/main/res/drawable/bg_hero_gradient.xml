<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/grad_hero_start"
                android:centerColor="@color/grad_hero_mid"
                android:endColor="@color/grad_hero_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="480"
                android:centerX="0.15"
                android:centerY="0.1"
                android:startColor="#4000E5D0"
                android:endColor="#00070B14" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="520"
                android:centerX="0.85"
                android:centerY="0.9"
                android:startColor="#3BFF3D8B"
                android:endColor="#00070B14" />
        </shape>
    </item>
</layer-list>
