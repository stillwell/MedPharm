# MedPharm ERP - Server Environment Configuration
# Copyright (C) 2026 Enlightec Ltd. (www.enlightec.com)
#
# Copy this file to .env and update the values for your deployment.
# Usage: cp .env.example .env && nano .env

# ── Security (CHANGE THESE IN PRODUCTION) ─────────────────────────────────────
MEDPHARM_JWT_SECRET=replace-with-a-64-char-random-hex-string
MEDPHARM_SECRET_KEY=replace-with-another-64-char-random-hex-string

# ── Shared database (PostgreSQL) ──────────────────────────────────────────────
# When MEDPHARM_DATABASE_URL is set, every MedPharm component connects to ONE
# PostgreSQL database, so the desktop app, web portal, REST API, and all mobile
# clients (via the API) read and write the same data. The compose `db` service
# reads MEDPHARM_DB_PASSWORD for its postgres superuser. Leave MEDPHARM_DATABASE_URL
# unset/commented to revert each component to its own single-node SQLite file.
MEDPHARM_DB_PASSWORD=replace-with-a-strong-db-password
MEDPHARM_DATABASE_URL=postgresql+psycopg://medpharm:replace-with-a-strong-db-password@db:5432/medpharm

# ── Ports ─────────────────────────────────────────────────────────────────────
MEDPHARM_HTTP_PORT=80
MEDPHARM_API_PORT=8080
MEDPHARM_WEB_PORT=5000

# ── Performance ───────────────────────────────────────────────────────────────
MEDPHARM_WORKERS=4
MEDPHARM_THREADS=2

# ── Authentication ────────────────────────────────────────────────────────────
MEDPHARM_TOKEN_EXPIRY=86400
MEDPHARM_REFRESH_EXPIRY=604800

# ── CORS (comma-separated origins, or * for all) ─────────────────────────────
MEDPHARM_CORS_ORIGINS=*
