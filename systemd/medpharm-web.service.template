# MedPharm ERP — Patient Web Portal (port 5000)
#
# Installed by install-services.sh. Placeholders ({{NAME}}) are substituted
# at install time. To regenerate after editing this template, re-run
# `sudo ./install-services.sh update-units`.
#
# Standard ops:
#   sudo systemctl status  medpharm-web
#   sudo systemctl restart medpharm-web
#   journalctl -u medpharm-web -f

[Unit]
Description=MedPharm ERP — Patient Web Portal (port {{WEB_PORT}})
Documentation=https://github.com/stillwell/MedPharm
# The web portal reads the same database the API writes; start it after the
# API is up so first-paint requests see a populated schema.
After=network-online.target medpharm-api.service
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{INSTALL_DIR}}

EnvironmentFile=-{{INSTALL_DIR}}/.env
EnvironmentFile=-/etc/medpharm/medpharm.env

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH={{INSTALL_DIR}}
Environment=MEDPHARM_HOST=0.0.0.0
Environment=MEDPHARM_PORT={{WEB_PORT}}
Environment=MEDPHARM_DB_PATH={{INSTALL_DIR}}/medpharm_erp.db

ExecStart={{INSTALL_DIR}}/venv/bin/gunicorn --workers {{WORKERS}} --threads 2 --bind 0.0.0.0:{{WEB_PORT}} --access-logfile - --error-logfile - --timeout 60 --graceful-timeout 30 run_web:app

Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# ── Sandboxing ───────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{INSTALL_DIR}}/data {{INSTALL_DIR}}/logs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
