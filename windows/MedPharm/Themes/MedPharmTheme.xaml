<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== COLOR TOKENS ==================== -->
    <Color x:Key="MPBgColor">#FF070B14</Color>
    <Color x:Key="MPBgElevatedColor">#FF0B1220</Color>
    <Color x:Key="MPSurfaceColor">#FF121A2B</Color>
    <Color x:Key="MPSurface2Color">#FF182236</Color>
    <Color x:Key="MPBorderColor">#FF2A3A5A</Color>

    <Color x:Key="MPPrimaryColor">#FF00E5D0</Color>
    <Color x:Key="MPPrimaryAltColor">#FF18B7FF</Color>
    <Color x:Key="MPAccentColor">#FFFF3D8B</Color>
    <Color x:Key="MPVioletColor">#FFB14BFF</Color>
    <Color x:Key="MPGoldColor">#FFFFB800</Color>

    <Color x:Key="MPSuccessColor">#FF00D97E</Color>
    <Color x:Key="MPWarningColor">#FFFF9F43</Color>
    <Color x:Key="MPDangerColor">#FFFF4757</Color>
    <Color x:Key="MPInfoColor">#FF30C1FF</Color>

    <Color x:Key="MPTextColor">#FFE9EEF7</Color>
    <Color x:Key="MPTextMutedColor">#FF8695B0</Color>
    <Color x:Key="MPTextDimColor">#FF5A6782</Color>

    <!-- ==================== SOLID BRUSHES ==================== -->
    <SolidColorBrush x:Key="MPBg"         Color="{StaticResource MPBgColor}" />
    <SolidColorBrush x:Key="MPBgElevated" Color="{StaticResource MPBgElevatedColor}" />
    <SolidColorBrush x:Key="MPSurface"    Color="{StaticResource MPSurfaceColor}" />
    <SolidColorBrush x:Key="MPSurface2"   Color="{StaticResource MPSurface2Color}" />
    <SolidColorBrush x:Key="MPBorder"     Color="{StaticResource MPBorderColor}" />

    <SolidColorBrush x:Key="MPPrimary"    Color="{StaticResource MPPrimaryColor}" />
    <SolidColorBrush x:Key="MPPrimaryAlt" Color="{StaticResource MPPrimaryAltColor}" />
    <SolidColorBrush x:Key="MPAccent"     Color="{StaticResource MPAccentColor}" />
    <SolidColorBrush x:Key="MPViolet"     Color="{StaticResource MPVioletColor}" />
    <SolidColorBrush x:Key="MPGold"       Color="{StaticResource MPGoldColor}" />

    <SolidColorBrush x:Key="MPSuccess"    Color="{StaticResource MPSuccessColor}" />
    <SolidColorBrush x:Key="MPWarning"    Color="{StaticResource MPWarningColor}" />
    <SolidColorBrush x:Key="MPDanger"     Color="{StaticResource MPDangerColor}" />
    <SolidColorBrush x:Key="MPInfo"       Color="{StaticResource MPInfoColor}" />

    <SolidColorBrush x:Key="MPText"       Color="{StaticResource MPTextColor}" />
    <SolidColorBrush x:Key="MPTextMuted"  Color="{StaticResource MPTextMutedColor}" />
    <SolidColorBrush x:Key="MPTextDim"    Color="{StaticResource MPTextDimColor}" />

    <!-- Backwards-compat aliases so legacy references keep working -->
    <SolidColorBrush x:Key="TealBrush"          Color="{StaticResource MPPrimaryColor}" />
    <SolidColorBrush x:Key="TealDarkBrush"      Color="{StaticResource MPPrimaryAltColor}" />
    <SolidColorBrush x:Key="TealLightBrush"     Color="#FFA7F3EB" />
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource MPAccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource MPSuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource MPWarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush"         Color="{StaticResource MPDangerColor}" />
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource MPBgColor}" />
    <SolidColorBrush x:Key="CardBrush"          Color="{StaticResource MPSurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource MPTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MPTextMutedColor}" />

    <!-- ==================== GRADIENT BRUSHES ==================== -->
    <LinearGradientBrush x:Key="MPGradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MPPrimaryColor}"    Offset="0.0" />
        <GradientStop Color="{StaticResource MPPrimaryAltColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource MPVioletColor}"     Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MPAccentColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource MPVioletColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientSuccess" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MPSuccessColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource MPPrimaryColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientDanger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MPDangerColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource MPAccentColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A1028" Offset="0.0" />
        <GradientStop Color="#FF1E0D36" Offset="0.5" />
        <GradientStop Color="#FF120A28" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientSurface" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9182236" Offset="0.0" />
        <GradientStop Color="#E60B1220" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MPGradientSidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0A1028" Offset="0.0" />
        <GradientStop Color="#FF0B1220" Offset="1.0" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MPGradientAuroraCyan" Center="0.15,0.2" GradientOrigin="0.15,0.2"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#3318B7FF" Offset="0.0" />
        <GradientStop Color="#0018B7FF" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="MPGradientAuroraViolet" Center="0.85,0.85" GradientOrigin="0.85,0.85"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#33B14BFF" Offset="0.0" />
        <GradientStop Color="#00B14BFF" Offset="1.0" />
    </RadialGradientBrush>

    <!-- ==================== TYPOGRAPHY ==================== -->
    <Style x:Key="MPPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="MPPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="MPSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MPKpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
    </Style>

    <Style x:Key="MPKpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MPPrimary}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="MPFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ==================== CARDS ==================== -->
    <Style x:Key="MPCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MPGradientSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy alias -->
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource MPCard}" />

    <Style x:Key="MPGlassCard" TargetType="Border">
        <Setter Property="Background" Value="#CC0B1220" />
        <Setter Property="BorderBrush" Value="#662A3A5A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="12" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MPKpiCard" TargetType="Border" BasedOn="{StaticResource MPCard}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <!-- ==================== BUTTONS ==================== -->
    <Style x:Key="MPPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF04121A" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="14" Background="{StaticResource MPGradientPrimary}"
                                Opacity="0.0">
                            <Border.Effect>
                                <BlurEffect Radius="22" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Face" CornerRadius="14" Background="{StaticResource MPGradientPrimary}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy alias -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MPPrimaryButton}" />

    <Style x:Key="MPGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MPPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource MPPrimary}"
                            Background="#1400E5D0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#2600E5D0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MPLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MPPrimary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MPPrimaryAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MPNavButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="10" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1418B7FF" />
                <Setter Property="Foreground" Value="{StaticResource MPText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MPNavButtonActive" TargetType="Button" BasedOn="{StaticResource MPNavButton}">
        <Setter Property="Foreground" Value="#FF04121A" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{StaticResource MPGradientPrimary}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== INPUTS ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="CaretBrush" Value="{StaticResource MPPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource MPPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="Background" Value="#BF070B14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Face" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{StaticResource MPPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{StaticResource MPPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="CaretBrush" Value="{StaticResource MPPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource MPPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="Background" Value="#BF070B14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Face" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{StaticResource MPPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush"
                                    Value="{StaticResource MPPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="Background" Value="#BF070B14" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="Background" Value="{StaticResource MPSurface}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ==================== TEXT DEFAULTS ==================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
    </Style>

    <!-- ==================== LIST / DATAGRID ==================== -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Face" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#141820" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#2200E5D0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#14182236" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#33182236" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource MPSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2200E5D0" />
                <Setter Property="Foreground" Value="{StaticResource MPText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MPText}" />
    </Style>

    <!-- ==================== TAB CONTROL ==================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MPTextMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            Margin="2,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#1418B7FF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MPGradientPrimary}" />
                            <Setter Property="Foreground" Value="#FF04121A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BADGES ==================== -->
    <Style x:Key="MPBadgeSuccess" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#2600D97E" />
        <Setter Property="BorderBrush" Value="#5900D97E" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="MPBadgeWarning" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#26FF9F43" />
        <Setter Property="BorderBrush" Value="#59FF9F43" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="MPBadgeDanger" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#26FF4757" />
        <Setter Property="BorderBrush" Value="#59FF4757" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="MPBadgeInfo" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#2600E5D0" />
        <Setter Property="BorderBrush" Value="#5900E5D0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ==================== HERO BANNER ==================== -->
    <Style x:Key="MPHeroBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MPGradientHero}" />
        <Setter Property="BorderBrush" Value="{StaticResource MPBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="28,22" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="10" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
