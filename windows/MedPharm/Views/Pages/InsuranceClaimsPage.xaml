<UserControl x:Class="MedPharm.Views.Pages.InsuranceClaimsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Insurance Claims"
                   FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}">
            <DataGrid x:Name="ClaimsGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" HeadersVisibility="Column" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNumber}" Width="180" />
                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceId}" Width="100" />
                    <DataGridTextColumn Header="Provider" Binding="{Binding InsuranceProvider}" Width="180" />
                    <DataGridTextColumn Header="Claimed" Binding="{Binding ClaimedAmount, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="Approved" Binding="{Binding ApprovedAmount, StringFormat=C}" Width="120" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDate}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
