<UserControl x:Class="MedPharm.Views.Pages.AppointmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Appointments"
                   FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}">
            <DataGrid x:Name="AppointmentsGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" HeadersVisibility="Column" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date/Time" Binding="{Binding ScheduledDatetime}" Width="180" />
                    <DataGridTextColumn Header="Type" Binding="{Binding AppointmentType}" Width="160" />
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="200" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMinutes}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
