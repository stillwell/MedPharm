<UserControl x:Class="MedPharm.Views.Pages.BillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Billing &amp; Payments"
                   FontSize="28" FontWeight="Bold" Margin="0,0,0,16" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Outstanding Balance:" FontSize="16" VerticalAlignment="Center" />
                <TextBlock x:Name="BalanceText" Text="$0.00" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Invoices"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="InvoicesGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="150" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="120" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            <DataGridTemplateColumn Header="Actions" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pay" Click="PayButton_Click" Tag="{Binding}"
                                                    Background="{StaticResource TealBrush}" Foreground="White"
                                                    BorderThickness="0" Padding="8,3" Margin="0,0,4,0" Cursor="Hand" />
                                            <Button Content="Insurance Claim" Click="ClaimButton_Click" Tag="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource TealBrush}"
                                                    BorderBrush="{StaticResource TealBrush}"
                                                    BorderThickness="1" Padding="8,3" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Payment History"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" Width="150" />
                            <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="180" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="120" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
