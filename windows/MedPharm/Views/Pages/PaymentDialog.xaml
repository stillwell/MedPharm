<Window x:Class="MedPharm.Views.Pages.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment"
        Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Record Payment" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TealBrush}" Margin="0,0,0,16" />

        <TextBlock Text="Invoice" Margin="0,0,0,4" />
        <TextBlock x:Name="InvoiceText" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Balance Due" Margin="0,0,0,4" />
        <TextBlock x:Name="BalanceText" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

        <TextBlock Text="Amount" Margin="0,0,0,4" />
        <TextBox x:Name="AmountBox" Padding="8" Margin="0,0,0,12" FontSize="14" />

        <TextBlock Text="Payment Method" Margin="0,0,0,4" />
        <ComboBox x:Name="MethodCombo" SelectedIndex="0" Padding="6" Margin="0,0,0,16">
            <ComboBoxItem Content="Credit Card" />
            <ComboBoxItem Content="Debit Card" />
            <ComboBoxItem Content="Cash" />
            <ComboBoxItem Content="Check" />
            <ComboBoxItem Content="Bank Transfer" />
            <ComboBoxItem Content="Insurance" />
            <ComboBoxItem Content="HSA/FSA" />
        </ComboBox>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SubmitBtn" Content="Submit Payment"
                    Style="{StaticResource PrimaryButton}" Click="Submit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
