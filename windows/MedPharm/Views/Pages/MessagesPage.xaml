<UserControl x:Class="MedPharm.Views.Pages.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Secure Messages"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button x:Name="NewMessageBtn" Content="New Message"
                    DockPanel.Dock="Right"
                    Padding="14,6"
                    HorizontalAlignment="Right"
                    Background="{StaticResource MPPrimary}"
                    Foreground="#FF04121A" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"
                    Click="NewMessageBtn_Click" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thread List -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Conversations"
                               FontWeight="SemiBold" Margin="8,8,8,4"
                               Foreground="{StaticResource MPTextMuted}" />
                    <ListBox x:Name="ThreadsList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="ThreadsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Display}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MPText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WithLine}"
                                               FontSize="11"
                                               Foreground="{StaticResource MPTextMuted}"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding LastMessageAt}"
                                               FontSize="10"
                                               Foreground="{StaticResource MPTextDim}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Conversation Pane -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <TextBlock x:Name="ThreadSubject" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource MPText}" />
                        <TextBlock x:Name="ThreadMeta" FontSize="12"
                                   Foreground="{StaticResource MPTextMuted}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="12,8,12,12" x:Name="ReplyArea">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplyInput" Grid.Column="0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource MPSurface}"
                                 Foreground="{StaticResource MPText}"
                                 BorderBrush="{StaticResource MPBorder}"
                                 BorderThickness="1" Padding="8" />
                        <Button x:Name="SendBtn" Grid.Column="1" Content="Send"
                                Margin="8,0,0,0" Padding="20,0" MinHeight="60"
                                Background="{StaticResource MPPrimary}"
                                Foreground="#FF04121A" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                Click="SendBtn_Click" />
                    </Grid>

                    <TextBlock x:Name="ClosedNote" DockPanel.Dock="Bottom"
                               Text="This thread is closed."
                               HorizontalAlignment="Center" Margin="0,12"
                               FontStyle="Italic"
                               Foreground="{StaticResource MPTextMuted}"
                               Visibility="Collapsed" />

                    <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <StackPanel x:Name="MessagesPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
