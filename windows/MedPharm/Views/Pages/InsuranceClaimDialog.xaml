<Window x:Class="MedPharm.Views.Pages.InsuranceClaimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Insurance Claim"
        Height="440" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="File Insurance Claim" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TealBrush}" Margin="0,0,0,16" />

        <TextBlock Text="Invoice" Margin="0,0,0,4" />
        <TextBlock x:Name="InvoiceText" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Balance Due" Margin="0,0,0,4" />
        <TextBlock x:Name="BalanceText" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Insurance Provider" Margin="0,0,0,4" />
        <ComboBox x:Name="InsuranceCombo" Padding="6" Margin="0,0,0,12"
                  DisplayMemberPath="ProviderName" />

        <TextBlock Text="Notes (optional)" Margin="0,0,0,4" />
        <TextBox x:Name="NotesBox" Padding="8" Margin="0,0,0,12"
                 AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

        <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SubmitBtn" Content="Submit Claim"
                    Style="{StaticResource PrimaryButton}" Click="Submit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
