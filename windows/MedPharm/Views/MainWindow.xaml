<Window x:Class="MedPharm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedPharm ERP"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource TealDarkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,30,20,20">
                    <TextBlock Text="MedPharm" FontSize="22" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="ERP" FontSize="12" Foreground="#B2EBF2" Margin="0,4,0,0" />
                    <TextBlock x:Name="UserNameText" FontSize="12" Foreground="#B2EBF2"
                               Margin="0,20,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,20">
                    <Button x:Name="LogoutBtn" Content="Log Out"
                            Background="Transparent" Foreground="White"
                            BorderBrush="#80FFFFFF" BorderThickness="1"
                            Padding="12,8" Cursor="Hand"
                            Click="LogoutBtn_Click" />
                </StackPanel>

                <StackPanel>
                    <Button x:Name="NavDashboard" Content="Dashboard" Tag="dashboard"
                            Click="Nav_Click" Style="{DynamicResource NavButton}" />
                    <Button x:Name="NavPrescriptions" Content="Prescriptions" Tag="prescriptions"
                            Click="Nav_Click" Style="{DynamicResource NavButton}" />
                    <Button x:Name="NavBilling" Content="Billing &amp; Payments" Tag="billing"
                            Click="Nav_Click" Style="{DynamicResource NavButton}" />
                    <Button x:Name="NavAppointments" Content="Appointments" Tag="appointments"
                            Click="Nav_Click" Style="{DynamicResource NavButton}" />
                    <Button x:Name="NavInsurance" Content="Insurance Claims" Tag="insurance"
                            Click="Nav_Click" Style="{DynamicResource NavButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid.Resources>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="24,14" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- Content Area -->
        <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="24" />
    </Grid>
</Window>
