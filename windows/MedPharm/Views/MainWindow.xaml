<Window x:Class="MedPharm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedPharm ERP"
        Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MPBg}">
    <Grid>
        <!-- Aurora backdrop -->
        <Grid>
            <Rectangle Fill="{StaticResource MPGradientAuroraCyan}" />
            <Rectangle Fill="{StaticResource MPGradientAuroraViolet}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource MPGradientSidebar}"
                    BorderBrush="{StaticResource MPBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,26,20,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{StaticResource MPGradientPrimary}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="20" FontWeight="Bold"
                                           Foreground="#FF04121A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-4,0,0" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MedPharm"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource MPText}" />
                                <TextBlock Text="ERP CONSOLE" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MPTextMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="UserNameText" FontSize="11"
                                   Foreground="{StaticResource MPTextMuted}"
                                   Margin="0,18,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,18">
                        <Border Height="1" Background="{StaticResource MPBorder}"
                                Margin="0,0,0,12" Opacity="0.6" />
                        <Button x:Name="LogoutBtn" Content="Log Out"
                                Background="Transparent"
                                Foreground="{StaticResource MPDanger}"
                                BorderBrush="{StaticResource MPDanger}"
                                BorderThickness="1" Padding="12,8"
                                Cursor="Hand" FontWeight="SemiBold"
                                Click="LogoutBtn_Click" />
                        <TextBlock Text="© 2026 Enlightec Ltd."
                                   Foreground="{StaticResource MPTextDim}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Margin="0,10,0,0">
                        <Button x:Name="NavDashboard" Content="  ▦   Dashboard" Tag="dashboard"
                                Click="Nav_Click" Style="{StaticResource MPNavButton}" />
                        <Button x:Name="NavPrescriptions" Content="  ℞   Prescriptions" Tag="prescriptions"
                                Click="Nav_Click" Style="{StaticResource MPNavButton}" />
                        <Button x:Name="NavBilling" Content="  $   Billing &amp; Payments" Tag="billing"
                                Click="Nav_Click" Style="{StaticResource MPNavButton}" />
                        <Button x:Name="NavAppointments" Content="  ◷   Appointments" Tag="appointments"
                                Click="Nav_Click" Style="{StaticResource MPNavButton}" />
                        <Button x:Name="NavInsurance" Content="  ✓   Insurance Claims" Tag="insurance"
                                Click="Nav_Click" Style="{StaticResource MPNavButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="24" />
        </Grid>
    </Grid>
</Window>
