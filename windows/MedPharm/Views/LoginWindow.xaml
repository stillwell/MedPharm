<Window x:Class="MedPharm.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedPharm ERP - Login"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,30">
            <TextBlock Text="MedPharm ERP"
                       FontSize="32" FontWeight="Bold"
                       Foreground="{StaticResource TealBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Medical &amp; Pharmaceutical Management"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Login Type" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="LoginTypeCombo" SelectedIndex="0" Padding="6" Margin="0,0,0,16">
                    <ComboBoxItem Content="Patient" />
                    <ComboBoxItem Content="Staff" />
                </ComboBox>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox" Padding="8" Margin="0,0,0,16" FontSize="14" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Padding="8" Margin="0,0,0,16" FontSize="14" />

                <Button x:Name="LoginButton" Content="Log In"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click" Margin="0,8,0,8" />

                <Button x:Name="RegisterButton" Content="Register as Patient"
                        Background="Transparent" Foreground="{StaticResource TealBrush}"
                        BorderBrush="{StaticResource TealBrush}"
                        BorderThickness="1" Padding="20,10"
                        Cursor="Hand" Click="RegisterButton_Click" Margin="0,0,0,12" />

                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <TextBlock Text="© 2026 Enlightec Ltd."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
