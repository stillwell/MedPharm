<Window x:Class="MedPharm.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedPharm ERP - Login"
        Icon="/Assets/medpharm-icon.ico"
        Height="760" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MPBg}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <!-- Aurora backdrop -->
        <Grid>
            <Rectangle Fill="{StaticResource MPGradientAuroraCyan}" />
            <Rectangle Fill="{StaticResource MPGradientAuroraViolet}" />
        </Grid>

        <Grid Margin="40,32,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand: Enlightec mark inside the halo, MedPharm banner
                 underneath. Falls back to the previous "+" placeholder if
                 the asset PNGs are missing from the build (kept inline so
                 the Window still opens cleanly during dev). -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,24">
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <Ellipse Width="120" Height="120" Fill="{StaticResource MPGradientPrimary}" Opacity="0.35">
                        <Ellipse.Effect>
                            <BlurEffect Radius="40" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image Source="/Assets/enlightec-logo.png"
                           Width="96" Height="96"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>

                <Image Source="/Assets/medpharm-banner.png"
                       MaxHeight="72"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
            </StackPanel>

            <!-- Glass form -->
            <Border Grid.Row="1" Style="{StaticResource MPGlassCard}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="SERVER URL" Style="{StaticResource MPFieldLabel}" />
                    <TextBox x:Name="ServerUrlBox"
                             ToolTip="API base URL, e.g. https://medpharm-erp.enlightec.com:8080/api/v1" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                        <Button x:Name="PasteServerButton" Content="Paste from clipboard"
                                Style="{StaticResource MPLinkButton}"
                                Click="PasteServerButton_Click"
                                ToolTip="Paste an ngrok URL or client-config JSON copied from the server's data/ngrok_client_config.json file." />
                        <Button x:Name="ResetServerButton" Content="Reset to default"
                                Style="{StaticResource MPLinkButton}"
                                Click="ResetServerButton_Click"
                                Margin="20,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="LOGIN TYPE" Style="{StaticResource MPFieldLabel}" />
                    <ComboBox x:Name="LoginTypeCombo" SelectedIndex="0" Margin="0,0,0,14">
                        <ComboBoxItem Content="Patient" />
                        <ComboBoxItem Content="Staff" />
                    </ComboBox>

                    <TextBlock Text="USERNAME" Style="{StaticResource MPFieldLabel}" />
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                    <TextBlock Text="PASSWORD" Style="{StaticResource MPFieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,18" />

                    <Button x:Name="LoginButton" Content="Log In →"
                            Style="{StaticResource MPPrimaryButton}"
                            Click="LoginButton_Click"
                            Margin="0,4,0,10" />

                    <Button x:Name="RegisterButton" Content="Register as Patient"
                            Style="{StaticResource MPGhostButton}"
                            Click="RegisterButton_Click"
                            Margin="0,0,0,12" />

                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MPDanger}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="© 2026 Enlightec Ltd. · HIPAA · TLS"
                       Foreground="{StaticResource MPTextDim}"
                       FontSize="10" HorizontalAlignment="Center"
                       Margin="0,18,0,0" />
        </Grid>
    </Grid>
</Window>
